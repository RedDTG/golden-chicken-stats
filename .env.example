# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ID du salon a ecouter (clic droit sur le salon > Copier l'ID, active le mode developpeur d'abord)
# Laisser vide pour ecouter tous les salons du serveur
WATCH_CHANNEL_ID=

# ID du bot UnbelievaBoat sur ton serveur (clic droit sur le bot dans la liste des membres > Copier l'ID)
UNBELIEVABOAT_ID=

# Fichier de credentials du compte de service Google (voir README pour la creation)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Alternative a GOOGLE_CREDENTIALS_FILE : contenu JSON du fichier de credentials
# directement en variable d'environnement (utile en prod, ex. Coolify, ou un fichier
# n'est pas pratique a fournir). Si definie, elle est prioritaire sur GOOGLE_CREDENTIALS_FILE.
GOOGLE_CREDENTIALS_JSON=

# ID de la feuille Google Sheets (dans l'URL : https://docs.google.com/spreadsheets/d/CET_ID/edit)
GOOGLE_SHEET_ID=

# Nom de l'onglet a utiliser dans la feuille
GOOGLE_SHEET_TAB=Cockfights

# Nom de l'onglet recapitulatif (une ligne par joueur + une ligne Total), doit
# deja exister dans la feuille
OVERVIEW_SHEET_TAB=Overview

# Fuseau horaire utilise pour la colonne Horodatage (nom IANA, ex. Europe/Paris)
# Independant du fuseau systeme du serveur qui heberge le bot
TIMEZONE=Europe/Paris

# Intervalle (en secondes) entre deux logs de progression pendant un backfill
# (salon/fil en cours + horodatage du message scanne)
BACKFILL_PROGRESS_INTERVAL=5

# Nom de l'onglet des balances suivies, doit deja exister dans la feuille
BANK_SHEET_TAB=Bank

# IDs Discord (separes par des virgules) des membres dont les +bal doivent
# etre journalises dans l'onglet Bank. Clic droit sur le membre > Copier
# l'ID (mode developpeur). Laisser vide pour desactiver le suivi Bank.
TRACKED_MEMBER_IDS=

# Chemin du fichier SQLite qui sert de source de verite pour Stats/Bank (voir
# README/CLAUDE.md). En deploiement conteneurise (Coolify, Docker...), ce
# chemin DOIT pointer vers un volume persistant, sinon il est efface a chaque
# redeploiement et la fiabilite qu'il apporte ne couvre plus qu'un simple
# crash/redemarrage du process, pas un redeploiement.
DB_PATH=bot.db

# Intervalle (en secondes) entre deux synchronisations SQLite -> Sheets (Stats,
# Bank et Overview). Les combats sont loggues en temps reel dans SQLite (fiable,
# local) quel que soit cet intervalle ; celui-ci ne controle que la frequence
# a laquelle Google Sheets est mis a jour par lots.
SYNC_INTERVAL=15

# ID du salon ou annoncer (avec @everyone) chaque nouveau record de
# probabilite de victoire (par serveur). Clic droit sur le salon > Copier
# l'ID. Laisser vide pour desactiver les annonces de record.
RECORD_CHANNEL_ID=

# Nom de l'onglet de statut de /backfill (salon en cours, dernier message
# traite, compteurs, derniere mise a jour) - doit deja exister dans la feuille.
BACKFILL_SHEET_TAB=Backfill

# Intervalle minimum (secondes) entre deux ecritures du statut de /backfill
# sur BACKFILL_SHEET_TAB. Plus large que BACKFILL_PROGRESS_INTERVAL (qui ne
# fait que logguer) pour ne pas empiler des ecritures Sheets trop frequentes
# sur un run de plusieurs heures.
BACKFILL_HEARTBEAT_INTERVAL=30
