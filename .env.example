# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ID du salon a ecouter (clic droit sur le salon > Copier l'ID, active le mode developpeur d'abord)
# Laisser vide pour ecouter tous les salons du serveur
WATCH_CHANNEL_ID=

# ID du bot UnbelievaBoat sur ton serveur (clic droit sur le bot dans la liste des membres > Copier l'ID)
UNBELIEVABOAT_ID=

# Fichier de credentials du compte de service Google (voir README pour la creation)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Alternative a GOOGLE_CREDENTIALS_FILE : contenu JSON du fichier de credentials
# directement en variable d'environnement (utile en prod, ex. Coolify, ou un fichier
# n'est pas pratique a fournir). Si definie, elle est prioritaire sur GOOGLE_CREDENTIALS_FILE.
GOOGLE_CREDENTIALS_JSON=

# ID de la feuille Google Sheets (dans l'URL : https://docs.google.com/spreadsheets/d/CET_ID/edit)
GOOGLE_SHEET_ID=

# Nom de l'onglet a utiliser dans la feuille
GOOGLE_SHEET_TAB=Cockfights

# Nom de l'onglet recapitulatif (une ligne par joueur + une ligne Total), doit
# deja exister dans la feuille
OVERVIEW_SHEET_TAB=Overview

# Fuseau horaire utilise pour la colonne Horodatage (nom IANA, ex. Europe/Paris)
# Independant du fuseau systeme du serveur qui heberge le bot
TIMEZONE=Europe/Paris

# Intervalle (en secondes) entre deux logs de progression pendant un backfill
# (salon/fil en cours + horodatage du message scanne)
BACKFILL_PROGRESS_INTERVAL=5
